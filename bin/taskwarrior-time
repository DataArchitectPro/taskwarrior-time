#!/usr/bin/env python3
"""Taskwarrior Time helper — JSON bridge between Omarchy Quickshell UI and task/timew.

Plugin id: taskwarrior-time
"""

from __future__ import annotations

import argparse
import json
import os
import re
import select
import shutil
import signal
import subprocess
import sys
import time
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import Any


TW_RC = [
    "rc.verbose=nothing",
    "rc.color=off",
    "rc.confirmation=off",
    "rc.bulk=0",
    "rc.gc=0",
]

# Hard caps so a huge/synchronized TW DB cannot hang or OOM the long-lived shell.
HELPER_TIMEOUT_SEC = 8.0
MAX_STDOUT_BYTES = 1_500_000
MAX_STDERR_BYTES = 64_000
MAX_TASKS = 1500
MAX_PROJECTS = 400
MAX_DEPS_PER_TASK = 40
MAX_TAGS_PER_TASK = 40
MAX_STRING_LEN = 2000
MAX_SHORT_STRING_LEN = 240
MAX_PAYLOAD_BYTES = 1_800_000


def which(name: str) -> bool:
    return shutil.which(name) is not None


def clip_str(value: Any, max_len: int = MAX_STRING_LEN) -> str:
    s = str(value or "")
    if len(s) <= max_len:
        return s
    if max_len <= 1:
        return s[:max_len]
    return s[: max_len - 1] + "…"


def _decode_chunks(chunks: list[bytes]) -> str:
    return b"".join(chunks).decode("utf-8", errors="replace")


def _kill_process_group(proc: subprocess.Popen[bytes]) -> None:
    """TERM→KILL the whole session, then reap. Fail closed on hung helpers."""
    if proc.poll() is not None:
        try:
            proc.wait(timeout=0.2)
        except subprocess.TimeoutExpired:
            pass
        return
    try:
        os.killpg(proc.pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    deadline = time.monotonic() + 0.5
    while proc.poll() is None and time.monotonic() < deadline:
        time.sleep(0.05)
    if proc.poll() is None:
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
    try:
        proc.wait(timeout=1.0)
    except subprocess.TimeoutExpired:
        pass


def run(
    cmd: list[str],
    input_text: str | None = None,
    timeout: float = HELPER_TIMEOUT_SEC,
) -> subprocess.CompletedProcess[str]:
    """Run a helper subprocess with incremental stdout/stderr ceilings.

    Unlike ``subprocess.run(capture_output=True)``, this never buffers an
    unbounded child dump: reads stop at ``MAX_STDOUT_BYTES`` /
    ``MAX_STDERR_BYTES``, and overflow or timeout kills the process group.
    """
    try:
        proc = subprocess.Popen(
            cmd,
            stdin=subprocess.PIPE if input_text is not None else subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            start_new_session=True,
        )
    except OSError as exc:
        return subprocess.CompletedProcess(cmd, 127, "", str(exc))

    if input_text is not None and proc.stdin is not None:
        try:
            proc.stdin.write(input_text.encode("utf-8", errors="replace"))
            proc.stdin.close()
        except BrokenPipeError:
            pass

    assert proc.stdout is not None and proc.stderr is not None
    out_chunks: list[bytes] = []
    err_chunks: list[bytes] = []
    out_len = 0
    err_len = 0
    overflow = False
    timed_out = False
    deadline = time.monotonic() + timeout
    readers: dict[int, tuple[str, Any]] = {
        proc.stdout.fileno(): ("out", proc.stdout),
        proc.stderr.fileno(): ("err", proc.stderr),
    }

    while readers:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            timed_out = True
            break
        ready, _, _ = select.select(list(readers), [], [], min(0.2, remaining))
        if not ready:
            if proc.poll() is not None:
                # Child exited — drain whatever is still buffered, then stop.
                ready, _, _ = select.select(list(readers), [], [], 0)
                if not ready:
                    break
            else:
                continue
        for fd in ready:
            kind, pipe = readers[fd]
            chunk = os.read(fd, 65536)
            if not chunk:
                readers.pop(fd, None)
                try:
                    pipe.close()
                except OSError:
                    pass
                continue
            if kind == "out":
                if out_len + len(chunk) > MAX_STDOUT_BYTES:
                    overflow = True
                    break
                out_chunks.append(chunk)
                out_len += len(chunk)
            else:
                if err_len + len(chunk) > MAX_STDERR_BYTES:
                    overflow = True
                    break
                err_chunks.append(chunk)
                err_len += len(chunk)
        if overflow:
            break

    if timed_out or overflow or proc.poll() is None:
        _kill_process_group(proc)
    else:
        try:
            proc.wait(timeout=0.5)
        except subprocess.TimeoutExpired:
            timed_out = True
            _kill_process_group(proc)

    for _, pipe in list(readers.values()):
        try:
            pipe.close()
        except OSError:
            pass

    if overflow:
        return subprocess.CompletedProcess(
            cmd, 125, "", "stdout/stderr exceeds size limit"
        )
    if timed_out:
        return subprocess.CompletedProcess(cmd, 124, "", "timeout")

    code = proc.returncode if proc.returncode is not None else 124
    return subprocess.CompletedProcess(
        cmd, code, _decode_chunks(out_chunks), _decode_chunks(err_chunks)
    )


def task_cmd(*args: str) -> subprocess.CompletedProcess[str]:
    return run(["task", *TW_RC, *args])


def ok_json(payload: dict[str, Any], code: int = 0) -> int:
    raw = json.dumps(payload, ensure_ascii=False)
    if len(raw.encode("utf-8", errors="replace")) > MAX_PAYLOAD_BYTES:
        # Fail closed rather than pushing an oversized snapshot into QML.
        raw = json.dumps(
            {
                "ok": False,
                "error": "snapshot exceeds size limit",
                "available": bool(payload.get("available", True)),
                "timewAvailable": bool(payload.get("timewAvailable", False)),
                "tasks": [],
                "projects": [],
                "pending": 0,
                "actionable": 0,
                "active": None,
                "label": "!",
                "tooltip": "Task snapshot too large",
            },
            ensure_ascii=False,
        )
        code = 1
    sys.stdout.write(raw)
    sys.stdout.write("\n")
    return code


def err_json(message: str, code: int = 1, **extra: Any) -> int:
    payload: dict[str, Any] = {
        "ok": False,
        "error": clip_str(message, MAX_SHORT_STRING_LEN),
        "available": True,
        "tasks": [],
        "projects": [],
        "pending": 0,
        "actionable": 0,
        "active": None,
        "label": "!",
        "tooltip": clip_str(message, MAX_SHORT_STRING_LEN),
    }
    payload.update(extra)
    return ok_json(payload, code)


def parse_iso(ts: str | None) -> datetime | None:
    if not ts:
        return None
    try:
        if ts.endswith("Z"):
            return datetime.strptime(ts, "%Y%m%dT%H%M%SZ").replace(tzinfo=timezone.utc)
        return datetime.fromisoformat(ts)
    except ValueError:
        return None


def seconds_between(start: str | None, end: str | None, now: datetime) -> int:
    s = parse_iso(start)
    if not s:
        return 0
    e = parse_iso(end) if end else now
    if not e:
        e = now
    return max(0, int((e - s).total_seconds()))


def format_duration(seconds: int) -> str:
    seconds = max(0, int(seconds))
    h, rem = divmod(seconds, 3600)
    m, s = divmod(rem, 60)
    if h:
        return f"{h}:{m:02d}:{s:02d}"
    return f"{m}:{s:02d}"


def parse_duration_to_seconds(text: str) -> int | None:
    """Parse UI durations: 30m, 1h, 1h30m, 1:30, 1:30:00, 90 (=minutes)."""
    raw = str(text or "").strip().lower().replace(" ", "")
    if not raw:
        return None
    # Accept Russian unit letters and common English unit words.
    for src, dst in (
        ("minutes", "m"),
        ("minute", "m"),
        ("mins", "m"),
        ("min", "m"),
        ("hours", "h"),
        ("hour", "h"),
        ("hrs", "h"),
        ("hr", "h"),
        ("seconds", "s"),
        ("second", "s"),
        ("secs", "s"),
        ("sec", "s"),
        ("ч", "h"),
        ("м", "m"),
        ("с", "s"),
    ):
        raw = raw.replace(src, dst)

    if re.fullmatch(r"\d+:\d{2}(:\d{2})?", raw):
        parts = [int(p) for p in raw.split(":")]
        if len(parts) == 2:
            return parts[0] * 3600 + parts[1] * 60
        return parts[0] * 3600 + parts[1] * 60 + parts[2]

    if re.fullmatch(r"\d+", raw):
        return int(raw) * 60

    # ISO-ish PT1H30M / P1DT2H — keep simple subset
    if raw.startswith("pt") or raw.startswith("p"):
        m = re.fullmatch(
            r"p(?:(\d+(?:\.\d+)?)d)?(?:t(?:(\d+(?:\.\d+)?)h)?(?:(\d+(?:\.\d+)?)m)?(?:(\d+(?:\.\d+)?)s)?)?",
            raw,
        )
        if m and any(m.groups()):
            days = float(m.group(1) or 0)
            hours = float(m.group(2) or 0)
            mins = float(m.group(3) or 0)
            secs = float(m.group(4) or 0)
            return int(days * 86400 + hours * 3600 + mins * 60 + secs)

    m = re.fullmatch(
        r"(?:(\d+(?:\.\d+)?)h)?(?:(\d+(?:\.\d+)?)m)?(?:(\d+(?:\.\d+)?)s)?",
        raw,
    )
    if m and any(m.groups()):
        hours = float(m.group(1) or 0)
        mins = float(m.group(2) or 0)
        secs = float(m.group(3) or 0)
        total = int(hours * 3600 + mins * 60 + secs)
        return total if total > 0 else None

    return None


def fmt_local(dt: datetime) -> str:
    return dt.astimezone().strftime("%Y-%m-%dT%H:%M:%S")


def find_raw_task(uuid: str) -> dict[str, Any] | None:
    tasks, _err = export_tasks()
    for t in tasks:
        if str(t.get("uuid") or "") == uuid:
            return t
    return None


def timew_day_intervals(tag: str | None = None) -> list[dict[str, Any]]:
    if not which("timew"):
        return []
    cmd = ["timew", "export", ":day"]
    if tag:
        cmd.append(tag)
    proc = run(cmd)
    if proc.returncode != 0:
        return []
    try:
        data = json.loads(proc.stdout or "[]")
    except json.JSONDecodeError:
        return []
    return [iv for iv in data if isinstance(iv, dict)]


def timew_open_start() -> datetime | None:
    """Start of the currently open (active) interval, if any."""
    for iv in timew_day_intervals():
        if iv.get("end"):
            continue
        return parse_iso(str(iv.get("start") or ""))
    # Fallback: unfiltered export in case open interval started before today
    if not which("timew"):
        return None
    proc = run(["timew", "get", "dom.active"])
    if proc.returncode != 0 or str(proc.stdout or "").strip() in ("", "0"):
        return None
    proc = run(["timew", "get", "dom.active.start"])
    ts = str(proc.stdout or "").strip()
    return parse_iso(ts) if ts else None


def ensure_aware(dt: datetime) -> datetime:
    if dt.tzinfo is None:
        return dt.replace(tzinfo=timezone.utc)
    return dt


def local_day_start(moment: datetime) -> datetime:
    local = ensure_aware(moment).astimezone()
    return local.replace(hour=0, minute=0, second=0, microsecond=0)


def timew_occupied_ranges(window_start: datetime, window_end: datetime) -> list[tuple[datetime, datetime]]:
    """Closed intervals overlapping [window_start, window_end], clipped to the window."""
    if not which("timew"):
        return []
    proc = run(
        [
            "timew",
            "export",
            fmt_local(window_start),
            "-",
            fmt_local(window_end + timedelta(seconds=1)),
        ]
    )
    if proc.returncode != 0:
        raw_list: list[Any] = timew_day_intervals()
    else:
        try:
            data = json.loads(proc.stdout or "[]")
        except json.JSONDecodeError:
            data = []
        raw_list = data if isinstance(data, list) else []

    ws = ensure_aware(window_start)
    we = ensure_aware(window_end)
    out: list[tuple[datetime, datetime]] = []
    for iv in raw_list:
        if not isinstance(iv, dict):
            continue
        s = parse_iso(str(iv.get("start") or ""))
        if not s:
            continue
        e = parse_iso(str(iv.get("end") or "")) if iv.get("end") else we
        if not e:
            continue
        s = ensure_aware(s)
        e = ensure_aware(e)
        # Clip to window
        cs = max(s, ws)
        ce = min(e, we)
        if cs < ce:
            out.append((cs, ce))
    # Merge overlapping/adjacent occupied blocks
    if not out:
        return []
    out.sort(key=lambda p: p[0])
    merged: list[tuple[datetime, datetime]] = [out[0]]
    for s, e in out[1:]:
        ps, pe = merged[-1]
        if s <= pe:
            merged[-1] = (ps, max(pe, e))
        else:
            merged.append((s, e))
    return merged


def free_gaps_today(anchor: datetime) -> list[tuple[datetime, datetime]]:
    """Free ranges within local today up to anchor, latest gap first."""
    anchor = ensure_aware(anchor)
    day_start = local_day_start(anchor)
    if anchor <= day_start:
        return []
    occupied = timew_occupied_ranges(day_start, anchor)
    gaps: list[tuple[datetime, datetime]] = []
    cursor = day_start
    for s, e in occupied:
        if cursor < s:
            gaps.append((cursor, s))
        cursor = max(cursor, e)
    if cursor < anchor:
        gaps.append((cursor, anchor))
    gaps.sort(key=lambda p: p[1], reverse=True)
    return gaps


def plan_today_track_slices(anchor: datetime, duration_secs: int) -> list[tuple[datetime, datetime]]:
    """
    Pack as much as possible into free gaps of local today (latest first).
    May return slices totaling less than duration_secs if the day is full.
    """
    if duration_secs <= 0:
        return []
    gaps = free_gaps_today(anchor)
    remaining = duration_secs
    slices: list[tuple[datetime, datetime]] = []
    for gap_start, gap_end in gaps:
        if remaining <= 0:
            break
        avail = int((gap_end - gap_start).total_seconds())
        if avail <= 0:
            continue
        take = min(remaining, avail)
        start = gap_end - timedelta(seconds=take)
        slices.append((start, gap_end))
        remaining -= take
    return slices


def today_key(moment: datetime | None = None) -> str:
    local = ensure_aware(moment or datetime.now(timezone.utc)).astimezone()
    return local.strftime("%Y%m%d")


def parse_timecorrection(raw_val: Any) -> tuple[str, int]:
    """UDA timecorrection format: YYYYMMDD:seconds (seconds may be negative)."""
    text = str(raw_val or "").strip()
    if not text:
        return "", 0
    if ":" not in text:
        # Legacy/plain seconds — treat as today
        try:
            return today_key(), int(float(text))
        except ValueError:
            return "", 0
    day, _, rest = text.partition(":")
    try:
        return day, int(float(rest))
    except ValueError:
        return "", 0


def timecorrection_for_today(raw_val: Any, moment: datetime | None = None) -> int:
    day, secs = parse_timecorrection(raw_val)
    if not day or day != today_key(moment):
        return 0
    return secs


def format_timecorrection(day: str, secs: int) -> str:
    return f"{day}:{int(secs)}"


def set_timecorrection(uuid: str, day: str, secs: int) -> subprocess.CompletedProcess[str]:
    if secs == 0:
        return task_cmd(uuid, "modify", "timecorrection:")
    return task_cmd(uuid, "modify", f"timecorrection:{format_timecorrection(day, secs)}")


def task_timew_tags(raw: dict[str, Any]) -> list[str]:
    tags = [str(raw.get("uuid") or ""), str(raw.get("description") or "")]
    project = str(raw.get("project") or "").strip()
    if project:
        tags.append(project)
    return [t for t in tags if t]


def export_tasks() -> tuple[list[dict[str, Any]], str | None]:
    # Prefer pending + completed (recent) + started; filter deleted out.
    proc = task_cmd("export")
    if proc.returncode == 124:
        return [], "task export timed out"
    if proc.returncode == 125:
        return [], "task export output too large"
    if proc.returncode != 0 and not (proc.stdout or "").strip():
        return [], None
    try:
        data = json.loads(proc.stdout or "[]")
    except json.JSONDecodeError:
        return [], "task export returned invalid JSON"
    if not isinstance(data, list):
        return [], "task export returned unexpected shape"
    tasks = [t for t in data if isinstance(t, dict) and t.get("status") != "deleted"]
    if len(tasks) > MAX_TASKS:
        return [], f"too many tasks ({len(tasks)} > {MAX_TASKS})"
    return tasks, None


def list_projects() -> list[str]:
    proc = task_cmd("_projects")
    if proc.returncode in (124, 125) or proc.returncode != 0:
        return []
    lines = [clip_str(ln.strip(), MAX_SHORT_STRING_LEN) for ln in (proc.stdout or "").splitlines() if ln.strip()]
    uniq = sorted(set(lines), key=str.casefold)
    return uniq[:MAX_PROJECTS]


EXTRA_PROJECTS_PATH = Path.home() / ".local" / "share" / "taskwarrior-time" / "extra-projects.json"
DATA_DIR = Path.home() / ".local" / "share" / "taskwarrior-time"
UI_SETTINGS_PATH = DATA_DIR / "ui-settings.json"
DEBUG_LOG_PATH = DATA_DIR / "debug.log"
DEBUG_LOG_MAX_BYTES = 2 * 1024 * 1024
LOG_SCHEMA_VERSION = 1
PLUGIN_ROOT = Path(__file__).resolve().parent.parent
# Legacy path inside the plugin dir triggered Omarchy hot-reload on every write.
_LEGACY_EXTRA_PROJECTS_PATH = (
    Path.home() / ".config" / "omarchy" / "plugins" / "taskwarrior-time" / "extra-projects.json"
)


def ensure_data_dir() -> None:
    """Create the plugin data dir as owner-only (0700); repair if looser."""
    DATA_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    try:
        if (DATA_DIR.stat().st_mode & 0o777) != 0o700:
            DATA_DIR.chmod(0o700)
    except OSError:
        pass


def _ensure_private_file(path: Path) -> None:
    """Tighten an existing file to 0600 before append/write."""
    try:
        if path.is_file() and (path.stat().st_mode & 0o777) != 0o600:
            path.chmod(0o600)
    except OSError:
        pass


def _open_private(path: Path, mode: str):
    """Open/create a file with mode 0600 (owner read/write only)."""
    ensure_data_dir()
    flags = os.O_WRONLY | os.O_CREAT
    if "a" in mode:
        flags |= os.O_APPEND
    elif "w" in mode:
        flags |= os.O_TRUNC
    fd = os.open(path, flags, 0o600)
    try:
        os.fchmod(fd, 0o600)
    except OSError:
        pass
    return os.fdopen(fd, mode, encoding="utf-8")


def _write_private_text(path: Path, text: str) -> None:
    with _open_private(path, "w") as fh:
        fh.write(text)


def _normalize_ui_language(value: Any) -> str:
    lang = str(value or "system").strip().lower()
    if lang in ("system", "ru", "en"):
        return lang
    return "system"


def load_ui_settings() -> dict[str, Any]:
    ensure_data_dir()
    defaults = {
        "debugLogging": False,
        "sessionId": "",
        "sessionStartedAt": "",
        "uiLanguage": "system",
    }
    try:
        data = json.loads(UI_SETTINGS_PATH.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError, TypeError):
        return dict(defaults)
    if not isinstance(data, dict):
        return dict(defaults)
    return {
        "debugLogging": bool(data.get("debugLogging")),
        "sessionId": str(data.get("sessionId") or ""),
        "sessionStartedAt": str(data.get("sessionStartedAt") or ""),
        "uiLanguage": _normalize_ui_language(data.get("uiLanguage")),
    }


def save_ui_settings(settings: dict[str, Any]) -> None:
    payload = {
        "debugLogging": bool(settings.get("debugLogging")),
        "sessionId": str(settings.get("sessionId") or ""),
        "sessionStartedAt": str(settings.get("sessionStartedAt") or ""),
        "uiLanguage": _normalize_ui_language(settings.get("uiLanguage")),
    }
    _write_private_text(
        UI_SETTINGS_PATH,
        json.dumps(payload, ensure_ascii=False, indent=2) + "\n",
    )


def _run_version_cmd(cmd: list[str]) -> str:
    try:
        proc = run(cmd, timeout=2.0)
    except Exception:
        return ""
    out = (proc.stdout or "").strip().splitlines()
    if not out:
        out = (proc.stderr or "").strip().splitlines()
    return clip_str(out[0] if out else "", 120)


def read_plugin_manifest() -> dict[str, Any]:
    path = PLUGIN_ROOT / "manifest.json"
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError, TypeError):
        return {}
    return data if isinstance(data, dict) else {}


def collect_env_fingerprint() -> dict[str, Any]:
    """Versions and host facts for issue triage — written once per debug session."""
    manifest = read_plugin_manifest()
    uname = os.uname()
    locale_env = (
        os.environ.get("LC_ALL")
        or os.environ.get("LC_MESSAGES")
        or os.environ.get("LANG")
        or ""
    )
    return {
        "pluginId": clip_str(manifest.get("id") or "taskwarrior-time", 64),
        "pluginVersion": clip_str(manifest.get("version") or "unknown", 32),
        "pluginName": clip_str(manifest.get("name") or "Taskwarrior Time", 64),
        "manifestSchema": int(manifest.get("schemaVersion") or 0),
        "helper": "bin/taskwarrior-time",
        "logSchema": LOG_SCHEMA_VERSION,
        "python": clip_str(sys.version.split()[0], 32),
        "platform": clip_str(sys.platform, 32),
        "os": clip_str(f"{uname.sysname} {uname.release}", 120),
        "machine": clip_str(uname.machine, 32),
        "desktop": clip_str(
            os.environ.get("XDG_CURRENT_DESKTOP")
            or os.environ.get("XDG_SESSION_DESKTOP")
            or "",
            64,
        ),
        "sessionType": clip_str(os.environ.get("XDG_SESSION_TYPE") or "", 32),
        "wayland": clip_str(os.environ.get("WAYLAND_DISPLAY") or "", 64),
        "locale": clip_str(locale_env, 64),
        "uiLanguage": _normalize_ui_language(load_ui_settings().get("uiLanguage")),
        "taskAvailable": which("task"),
        "timewAvailable": which("timew"),
        "taskVersion": _run_version_cmd(["task", "--version"]) if which("task") else "",
        "timewVersion": _run_version_cmd(["timew", "--version"]) if which("timew") else "",
        "omarchyVersion": _run_version_cmd(["omarchy", "version"]) if which("omarchy") else "",
        "home": clip_str(str(Path.home()), 200),
        "dataDir": clip_str(str(DATA_DIR), 200),
        "logPath": clip_str(str(DEBUG_LOG_PATH), 200),
        "pluginRoot": clip_str(str(PLUGIN_ROOT), 200),
    }


def _sanitize_log_value(value: Any, *, depth: int = 0) -> Any:
    """Keep log payloads small and free of huge free-text dumps."""
    if depth > 3:
        return "…"
    if value is None or isinstance(value, (bool, int, float)):
        return value
    if isinstance(value, str):
        return clip_str(value, MAX_SHORT_STRING_LEN)
    if isinstance(value, dict):
        out: dict[str, Any] = {}
        for i, (k, v) in enumerate(value.items()):
            if i >= 40:
                out["_truncated"] = True
                break
            out[clip_str(str(k), 64)] = _sanitize_log_value(v, depth=depth + 1)
        return out
    if isinstance(value, (list, tuple)):
        items = [_sanitize_log_value(v, depth=depth + 1) for v in list(value)[:40]]
        if len(value) > 40:
            items.append({"_truncated": True, "len": len(value)})
        return items
    return clip_str(str(value), MAX_SHORT_STRING_LEN)


def _rotate_debug_log_if_needed() -> None:
    try:
        if DEBUG_LOG_PATH.is_file() and DEBUG_LOG_PATH.stat().st_size > DEBUG_LOG_MAX_BYTES:
            bak = DEBUG_LOG_PATH.with_suffix(".log.1")
            if bak.is_file():
                bak.unlink()
            DEBUG_LOG_PATH.rename(bak)
            _ensure_private_file(bak)
    except OSError:
        pass


def _write_human_banner(fh, env: dict[str, Any], session_id: str, started_at: str) -> None:
    """Human-readable preamble so issue readers see context without parsing JSON."""
    lines = [
        "# Taskwarrior Time — debug log (NDJSON)",
        f"# logSchema={LOG_SCHEMA_VERSION}  session={session_id}  started={started_at}",
        f"# plugin={env.get('pluginId')} {env.get('pluginVersion')}"
        f"  task={env.get('taskVersion') or 'n/a'}"
        f"  timew={env.get('timewVersion') or 'n/a'}"
        f"  omarchy={env.get('omarchyVersion') or 'n/a'}",
        f"# os={env.get('os')}  desktop={env.get('desktop') or 'n/a'}"
        f"  locale={env.get('locale') or 'n/a'}  uiLanguage={env.get('uiLanguage')}",
        f"# log={env.get('logPath')}",
        "# Attach this whole file to a GitHub issue. Redact private task text if needed.",
        "# Format: one JSON object per line after this banner.",
        "#",
    ]
    fh.write("\n".join(lines) + "\n")


def append_debug_log(
    event: str,
    detail: dict[str, Any] | None = None,
    *,
    level: str = "info",
    component: str = "helper",
) -> None:
    """Append one structured NDJSON line. Caller gates whether logging is enabled."""
    ensure_data_dir()
    _rotate_debug_log_if_needed()
    settings = load_ui_settings()
    now = datetime.now().astimezone()
    started = settings.get("sessionStartedAt") or ""
    elapsed = ""
    if started:
        try:
            t0 = datetime.fromisoformat(started)
            elapsed_s = (now - t0).total_seconds()
            elapsed = f"{elapsed_s:.3f}s"
        except ValueError:
            elapsed = "?"
    lvl = str(level or "info").lower()
    if lvl not in ("debug", "info", "warn", "error"):
        lvl = "info"
    comp = str(component or "helper").lower()
    if comp not in ("ui", "helper", "system"):
        comp = "helper"
    payload = _sanitize_log_value(detail if isinstance(detail, dict) else {})
    line = {
        "v": LOG_SCHEMA_VERSION,
        "ts": now.isoformat(timespec="milliseconds"),
        "elapsed": elapsed,
        "session": settings.get("sessionId") or "",
        "level": lvl,
        "component": comp,
        "event": clip_str(event or "log", MAX_SHORT_STRING_LEN),
        "pid": os.getpid(),
        "detail": payload if isinstance(payload, dict) else {"value": payload},
    }
    _ensure_private_file(DEBUG_LOG_PATH)
    with _open_private(DEBUG_LOG_PATH, "a") as fh:
        fh.write(json.dumps(line, ensure_ascii=False) + "\n")


def write_session_banner(*, clear_file: bool = False) -> dict[str, Any]:
    """Write/overwrite human banner + session.start env fingerprint."""
    settings = load_ui_settings()
    session_id = str(settings.get("sessionId") or "")
    started_at = str(settings.get("sessionStartedAt") or "")
    env = collect_env_fingerprint()
    mode = "w" if clear_file else "a"
    _ensure_private_file(DEBUG_LOG_PATH)
    with _open_private(DEBUG_LOG_PATH, mode) as fh:
        _write_human_banner(fh, env, session_id, started_at)
    append_debug_log(
        "session.start",
        {
            "sessionId": session_id,
            "startedAt": started_at,
            "env": env,
        },
        level="info",
        component="system",
    )
    return env


def begin_debug_session() -> dict[str, Any]:
    import secrets

    settings = load_ui_settings()
    settings["debugLogging"] = True
    settings["sessionId"] = secrets.token_hex(4)
    settings["sessionStartedAt"] = datetime.now().astimezone().isoformat(timespec="seconds")
    save_ui_settings(settings)
    # Fresh capture each time logging is enabled.
    write_session_banner(clear_file=True)
    return settings


def end_debug_session() -> dict[str, Any]:
    settings = load_ui_settings()
    if settings.get("debugLogging"):
        append_debug_log(
            "session.end",
            {"sessionId": settings.get("sessionId") or ""},
            level="info",
            component="system",
        )
    settings["debugLogging"] = False
    save_ui_settings(settings)
    return settings


def cmd_settings_get(_: argparse.Namespace) -> int:
    s = load_ui_settings()
    return ok_json(
        {
            "ok": True,
            "debugLogging": bool(s.get("debugLogging")),
            "sessionId": s.get("sessionId") or "",
            "sessionStartedAt": s.get("sessionStartedAt") or "",
            "uiLanguage": _normalize_ui_language(s.get("uiLanguage")),
            "logPath": str(DEBUG_LOG_PATH),
            "logSchema": LOG_SCHEMA_VERSION,
        }
    )


def cmd_settings_set(args: argparse.Namespace) -> int:
    dbg = getattr(args, "debug_logging", None)
    lang = getattr(args, "ui_language", None)
    if dbg is None and lang is None:
        return err_json("pass --debug-logging/--no-debug-logging and/or --ui-language")

    if dbg is True:
        begin_debug_session()
    elif dbg is False:
        end_debug_session()

    if lang is not None:
        s = load_ui_settings()
        s["uiLanguage"] = _normalize_ui_language(lang)
        save_ui_settings(s)

    s = load_ui_settings()
    return ok_json(
        {
            "ok": True,
            "debugLogging": bool(s.get("debugLogging")),
            "sessionId": s.get("sessionId") or "",
            "sessionStartedAt": s.get("sessionStartedAt") or "",
            "uiLanguage": _normalize_ui_language(s.get("uiLanguage")),
            "logPath": str(DEBUG_LOG_PATH),
            "logSchema": LOG_SCHEMA_VERSION,
        }
    )


def cmd_debug_log(args: argparse.Namespace) -> int:
    # Always append when invoked — UI only calls this while logging is on.
    detail: dict[str, Any] = {}
    raw = getattr(args, "json", None)
    if raw:
        try:
            parsed = json.loads(raw)
            if isinstance(parsed, dict):
                detail = parsed
        except json.JSONDecodeError:
            detail = {"_badJson": str(raw)[:200]}
    msg = getattr(args, "message", None)
    if msg:
        detail["message"] = str(msg)[:500]
    append_debug_log(
        str(getattr(args, "event", "") or "log"),
        detail,
        level=str(getattr(args, "level", None) or "info"),
        component=str(getattr(args, "component", None) or "ui"),
    )
    return ok_json({"ok": True})


def cmd_debug_log_clear(_: argparse.Namespace) -> int:
    """Remove debug.log (+ rotated backup). If logging is on, rewrite a fresh banner."""
    ensure_data_dir()
    cleared: list[str] = []
    for path in (DEBUG_LOG_PATH, DEBUG_LOG_PATH.with_suffix(".log.1")):
        try:
            if path.is_file():
                path.unlink()
                cleared.append(str(path))
        except OSError as exc:
            return err_json(f"failed to clear {path.name}: {exc}")

    settings = load_ui_settings()
    if settings.get("debugLogging"):
        write_session_banner(clear_file=True)
        append_debug_log(
            "session.cleared",
            {"cleared": cleared},
            level="info",
            component="system",
        )
    else:
        try:
            _write_private_text(DEBUG_LOG_PATH, "")
        except OSError as exc:
            return err_json(f"failed to recreate debug.log: {exc}")

    return ok_json(
        {
            "ok": True,
            "cleared": cleared,
            "logPath": str(DEBUG_LOG_PATH),
            "logSchema": LOG_SCHEMA_VERSION,
            "loggingActive": bool(settings.get("debugLogging")),
        }
    )


def load_extra_projects() -> list[str]:
    path = EXTRA_PROJECTS_PATH
    if not path.is_file() and _LEGACY_EXTRA_PROJECTS_PATH.is_file():
        try:
            path = _LEGACY_EXTRA_PROJECTS_PATH
        except OSError:
            path = EXTRA_PROJECTS_PATH
    try:
        raw = path.read_text(encoding="utf-8")
        data = json.loads(raw)
    except (OSError, json.JSONDecodeError, TypeError):
        return []
    if not isinstance(data, list):
        return []
    out: list[str] = []
    for item in data:
        name = str(item or "").strip()
        if name and ":" not in name and name not in out:
            out.append(name)
    return out


def save_extra_projects(names: list[str]) -> None:
    cleaned: list[str] = []
    for name in names:
        n = str(name or "").strip()
        if n and ":" not in n and n not in cleaned:
            cleaned.append(n)
    _write_private_text(
        EXTRA_PROJECTS_PATH,
        json.dumps(sorted(cleaned, key=str.casefold), ensure_ascii=False, indent=2) + "\n",
    )
    # Remove legacy file so the plugin watcher stops spuriously reloading.
    try:
        if _LEGACY_EXTRA_PROJECTS_PATH.is_file():
            _LEGACY_EXTRA_PROJECTS_PATH.unlink()
    except OSError:
        pass


def all_projects() -> list[str]:
    """TW projects plus locally created names not yet assigned to a task."""
    tw = set(list_projects())
    extras = load_extra_projects()
    # Drop extras that already exist in Taskwarrior — no longer needed locally.
    keep = [n for n in extras if n not in tw]
    if keep != extras:
        save_extra_projects(keep)
    return sorted(tw | set(keep), key=str.casefold)


def timew_active_and_today() -> tuple[dict[str, Any] | None, dict[str, int], str | None]:
    """Return (active interval summary, description->seconds today, error)."""
    now = datetime.now(timezone.utc)
    today: dict[str, int] = {}
    active: dict[str, Any] | None = None

    if not which("timew"):
        return None, today, None

    proc = run(["timew", "export", ":day"])
    if proc.returncode == 124:
        return None, today, "timew export timed out"
    if proc.returncode == 125:
        return None, today, "timew export output too large"
    if proc.returncode != 0:
        return None, today, None
    try:
        intervals = json.loads(proc.stdout or "[]")
    except json.JSONDecodeError:
        return None, today, "timew export returned invalid JSON"
    if not isinstance(intervals, list):
        return None, today, "timew export returned unexpected shape"
    if len(intervals) > MAX_TASKS:
        return None, today, f"too many timew intervals ({len(intervals)} > {MAX_TASKS})"

    uuid_re = re.compile(
        r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        re.I,
    )

    for iv in intervals:
        if not isinstance(iv, dict):
            continue
        tags = [clip_str(t, MAX_SHORT_STRING_LEN) for t in (iv.get("tags") or [])][:MAX_TAGS_PER_TASK]
        secs = seconds_between(iv.get("start"), iv.get("end"), now)
        uuids = [t for t in tags if uuid_re.match(t)]
        # Prefer UUID tags; also index by non-uuid tags (description/project).
        keys = uuids if uuids else [t for t in tags if not uuid_re.match(t)]
        for key in keys:
            today[key] = today.get(key, 0) + secs
        if not iv.get("end"):
            active = {
                "tags": tags,
                "uuids": uuids,
                "start": iv.get("start"),
                "description": next(
                    (t for t in tags if not uuid_re.match(t) and t not in uuids),
                    "",
                ),
            }

    return active, today, None


def normalize_task(raw: dict[str, Any], today: dict[str, int], active: dict[str, Any] | None) -> dict[str, Any]:
    uuid = clip_str(raw.get("uuid") or "", 64)
    desc = clip_str(raw.get("description") or "", MAX_STRING_LEN)
    project = clip_str(raw.get("project") or "", MAX_SHORT_STRING_LEN)
    depends = raw.get("depends") or []
    if isinstance(depends, str):
        depends = [d for d in depends.replace(",", " ").split() if d]
    elif not isinstance(depends, list):
        depends = []
    depends = [clip_str(d, 64) for d in depends][:MAX_DEPS_PER_TASK]

    today_secs = 0
    if uuid and uuid in today:
        today_secs = today[uuid]
    elif desc and desc in today:
        today_secs = today[desc]
    # Manual adjustments when the Timewarrior timeline has no free slot.
    today_secs = max(0, today_secs + timecorrection_for_today(raw.get("timecorrection")))
    # If tagged with both project and description, timew sums may be on either.

    # Source of truth is Taskwarrior's start attribute (timew can lag the hook).
    timer_active = bool(raw.get("start"))

    due = raw.get("due")
    scheduled = raw.get("scheduled")
    wait = raw.get("wait")
    raw_status = str(raw.get("status") or "")
    # TW3 keeps status=pending when wait: is set; surface as "waiting" while wait is future.
    status = raw_status
    if raw_status == "pending" and wait:
        wait_dt = parse_iso(str(wait))
        if wait_dt and wait_dt > datetime.now(timezone.utc):
            status = "waiting"

    overdue = False
    if due and status == "pending":
        due_dt = parse_iso(str(due))
        if due_dt and due_dt < datetime.now(timezone.utc):
            overdue = True

    tags_raw = raw.get("tags") or []
    if not isinstance(tags_raw, list):
        tags_raw = []
    tags = [clip_str(t, MAX_SHORT_STRING_LEN) for t in tags_raw][:MAX_TAGS_PER_TASK]

    return {
        "id": int(raw.get("id") or 0),
        "uuid": uuid,
        "description": desc,
        "status": clip_str(status, 32),
        "project": project,
        "priority": clip_str(raw.get("priority") or "", 8),
        "scheduled": clip_str(scheduled, 32) if scheduled else "",
        "due": clip_str(due, 32) if due else "",
        "wait": clip_str(wait, 32) if wait else "",
        "waitingFor": clip_str(raw.get("waitingfor") or "", MAX_SHORT_STRING_LEN),
        "outcome": clip_str(raw.get("outcome") or "", MAX_STRING_LEN),
        "details": clip_str(raw.get("details") or "", MAX_STRING_LEN),
        "start": clip_str(raw.get("start") or "", 32),
        "end": clip_str(raw.get("end") or "", 32),
        "depends": depends,
        "blocks": [],
        "urgency": float(raw.get("urgency") or 0),
        "tags": tags,
        "timerActive": timer_active,
        "todaySeconds": today_secs,
        "todayLabel": format_duration(today_secs) if today_secs else "",
        "overdue": overdue,
        "blocked": False,
        "blocking": False,
    }


def cmd_export(_: argparse.Namespace, extra: dict | None = None) -> int:
    available = which("task")
    timew_available = which("timew")
    if not available:
        payload = {
            "ok": True,
            "available": False,
            "timewAvailable": timew_available,
            "tasks": [],
            "projects": [],
            "pending": 0,
            "actionable": 0,
            "active": None,
            "label": "!",
            "tooltip": "",
            "waiting": 0,
        }
        if extra:
            payload.update(extra)
        return ok_json(payload)

    active, today, tw_err = timew_active_and_today()
    if tw_err:
        return err_json(tw_err, timewAvailable=timew_available)

    raw_tasks, export_err = export_tasks()
    if export_err:
        return err_json(export_err, timewAvailable=timew_available)

    tasks = [normalize_task(t, today, active) for t in raw_tasks]

    # Resolve dependency graph both ways:
    # - depends: tasks this one waits on
    # - blocks:  tasks that wait on this one
    by_uuid = {t["uuid"]: t for t in tasks if t["uuid"]}
    completed = {u for u, t in by_uuid.items() if t["status"] == "completed"}
    open_statuses = {"pending", "waiting"}

    for t in tasks:
        t["blocks"] = []
        t["blocking"] = False
        deps = t.get("depends") or []
        unresolved = [d for d in deps if d not in completed]
        t["blocked"] = t["status"] in open_statuses and len(unresolved) > 0

    for t in tasks:
        for dep_uuid in t.get("depends") or []:
            blocker = by_uuid.get(str(dep_uuid))
            if not blocker:
                continue
            blocker["blocks"].append(t["uuid"])
            if t["status"] in open_statuses and blocker["status"] in open_statuses:
                blocker["blocking"] = True

    pending = [t for t in tasks if t["status"] == "pending"]
    waiting = [t for t in tasks if t["status"] == "waiting"]
    actionable = [
        t
        for t in pending
        if t.get("overdue")
        or (t.get("due") and parse_iso(t["due"]) and parse_iso(t["due"]).date() <= datetime.now(timezone.utc).date())
    ]

    active_desc = ""
    active_uuid = ""
    for t in tasks:
        if t.get("timerActive"):
            active_desc = clip_str(t.get("description") or "", MAX_SHORT_STRING_LEN)
            active_uuid = clip_str(t.get("uuid") or "", 64)
            break
    if not active_desc and active:
        active_desc = clip_str(active.get("description") or "", MAX_SHORT_STRING_LEN)
        uu = active.get("uuids") or []
        active_uuid = clip_str(uu[0] if uu else "", 64)

    count = len(pending)
    waiting_count = len(waiting)
    label_count = len(actionable) if actionable else count
    icon = "\uf0ae"
    label = f"{icon}  {label_count}" if (count or waiting_count) else icon

    payload = {
        "ok": True,
        "available": True,
        "timewAvailable": timew_available,
        "tasks": tasks,
        "projects": all_projects()[:MAX_PROJECTS],
        "pending": count,
        "waiting": waiting_count,
        "actionable": len(actionable),
        "active": {
            "description": active_desc,
            "uuid": active_uuid,
        }
        if active_desc or active_uuid
        else None,
        "label": label,
        # Tip text is composed in QML so it follows the UI language.
        "tooltip": "",
    }
    if extra:
        payload.update(extra)
    return ok_json(payload)


def build_mods(args: argparse.Namespace) -> list[str]:
    mods: list[str] = []
    if getattr(args, "description", None):
        mods.append(args.description)
    if getattr(args, "project", None) is not None:
        if args.project == "":
            mods.append("project:")
        else:
            mods.append(f"project:{args.project}")
    if getattr(args, "priority", None) is not None:
        if args.priority == "":
            mods.append("priority:")
        else:
            mods.append(f"priority:{args.priority}")
    if getattr(args, "scheduled", None) is not None:
        if args.scheduled == "":
            mods.append("scheduled:")
        else:
            mods.append(f"scheduled:{args.scheduled}")
    if getattr(args, "due", None) is not None:
        if args.due == "":
            mods.append("due:")
        else:
            mods.append(f"due:{args.due}")
    if getattr(args, "details", None) is not None:
        if args.details == "":
            mods.append("details:")
        else:
            mods.append(f"details:{args.details}")
    return mods


def mutate_and_export(proc: subprocess.CompletedProcess[str]) -> int:
    if proc.returncode != 0:
        msg = (proc.stderr or proc.stdout or "task command failed").strip()
        return err_json(msg, code=1)
    # Re-export snapshot for UI refresh convenience
    ns = argparse.Namespace()
    return cmd_export(ns)


def patch_task_json(uuid: str, fields: dict[str, Any]) -> subprocess.CompletedProcess[str]:
    """Merge fields into a task via `task import` (needed for multiline UDAs)."""
    proc = task_cmd(uuid, "export")
    if proc.returncode != 0:
        return proc
    try:
        data = json.loads(proc.stdout or "[]")
    except json.JSONDecodeError:
        return subprocess.CompletedProcess(proc.args, 1, "", "invalid task export")
    if not isinstance(data, list) or not data:
        return subprocess.CompletedProcess(proc.args, 1, "", "task not found")
    task = data[0]
    for key, value in fields.items():
        if value is None or value == "":
            task.pop(key, None)
        else:
            task[key] = value
    return run(["task", *TW_RC, "import", "-"], input_text=json.dumps([task]))


def cmd_add(args: argparse.Namespace) -> int:
    if not args.description or not str(args.description).strip():
        return err_json("description is required")
    details = getattr(args, "details", None)
    waiting_for = getattr(args, "waiting_for", None)
    outcome = getattr(args, "outcome", None)
    depends = [str(d) for d in (getattr(args, "depend", None) or []) if d]
    start_timer = bool(getattr(args, "start_timer", False))
    # Don't pass details through CLI modify syntax — multiline breaks it.
    tmp = argparse.Namespace(
        description=args.description,
        project=args.project,
        priority=args.priority,
        scheduled=args.scheduled,
        due=args.due,
        details=None,
    )
    mods = build_mods(tmp)
    desc = mods[0]
    rest = list(mods[1:])
    # Default lifecycle: Waiting → In progress → Done.
    # TW models waiting as pending + future wait:.
    status = str(getattr(args, "status", None) or "waiting").strip().lower()
    mark_done = status in ("completed", "done")
    if status in ("waiting", "wait"):
        rest.append("wait:tomorrow")
    elif status in ("pending", "open", ""):
        pass
    elif mark_done:
        pass
    else:
        return err_json("status must be waiting, pending, or completed")
    before_tasks, before_err = export_tasks()
    if before_err:
        return err_json(before_err)
    before = {str(t.get("uuid") or "") for t in before_tasks}
    proc = task_cmd("add", *rest, "--", desc)
    if proc.returncode != 0:
        return mutate_and_export(proc)

    after, after_err = export_tasks()
    if after_err:
        return err_json(after_err)
    new_uuid = ""
    for t in after:
        u = str(t.get("uuid") or "")
        if u and u not in before:
            new_uuid = u
            break

    if new_uuid:
        if details is not None and str(details) != "":
            patch = patch_task_json(new_uuid, {"details": str(details)})
            if patch.returncode != 0:
                return mutate_and_export(patch)
        if waiting_for is not None and str(waiting_for).strip() != "":
            wf = task_cmd(new_uuid, "modify", f"waitingfor:{waiting_for}")
            if wf.returncode != 0:
                return mutate_and_export(wf)
        if outcome is not None and str(outcome).strip() != "":
            oc = task_cmd(new_uuid, "modify", f"outcome:{outcome}")
            if oc.returncode != 0:
                return mutate_and_export(oc)
        for dep in depends:
            dep_proc = task_cmd(new_uuid, "modify", f"depends:{dep}")
            if dep_proc.returncode != 0:
                return mutate_and_export(dep_proc)
        if mark_done:
            done_proc = task_cmd(new_uuid, "done")
            if done_proc.returncode != 0:
                return mutate_and_export(done_proc)
        elif start_timer:
            # Start only makes sense for an open task.
            start_proc = task_cmd(new_uuid, "start")
            if start_proc.returncode != 0:
                return mutate_and_export(start_proc)

    return cmd_export(argparse.Namespace(), extra={"createdUuid": new_uuid} if new_uuid else None)


def cmd_modify(args: argparse.Namespace) -> int:
    if not args.uuid:
        return err_json("uuid is required")
    mods: list[str] = []
    if args.description is not None and args.description != "":
        mods.append(f"description:{args.description}")
    # Reuse optional field builders without requiring description first.
    # `details` is applied via JSON import so multiline notes survive.
    details = getattr(args, "details", None)
    tmp = argparse.Namespace(
        description=None,
        project=args.project,
        priority=args.priority,
        scheduled=args.scheduled,
        due=args.due,
        details=None,
    )
    mods.extend(build_mods(tmp))
    if not mods and details is None:
        return err_json("no modifications")
    if mods:
        proc = task_cmd(args.uuid, "modify", *mods)
        if proc.returncode != 0:
            return mutate_and_export(proc)
    if details is not None:
        proc = patch_task_json(args.uuid, {"details": str(details)})
        if proc.returncode != 0:
            return mutate_and_export(proc)
    return cmd_export(argparse.Namespace())


def cmd_done(args: argparse.Namespace) -> int:
    return mutate_and_export(task_cmd(args.uuid, "done"))


def cmd_delete(args: argparse.Namespace) -> int:
    return mutate_and_export(task_cmd(args.uuid, "delete"))


def cmd_start(args: argparse.Namespace) -> int:
    return mutate_and_export(task_cmd(args.uuid, "start"))


def cmd_stop(args: argparse.Namespace) -> int:
    proc = task_cmd(args.uuid, "stop")
    # Ensure Timewarrior closes even if the hook missed a race.
    if which("timew"):
        run(["timew", "stop", ":yes"])
    return mutate_and_export(proc)


def cmd_status(args: argparse.Namespace) -> int:
    # pending | completed via done | waiting (via wait: date + optional waitingfor UDA)
    st = args.status
    if st == "completed" or st == "done":
        return mutate_and_export(task_cmd(args.uuid, "done"))
    if st == "pending":
        # Clear wait + reason so TW leaves virtual Waiting state.
        return mutate_and_export(task_cmd(args.uuid, "modify", "status:pending", "wait:", "waitingfor:"))
    if st == "waiting":
        wait = args.wait or "tomorrow"
        mods = ["status:pending", f"wait:{wait}"]
        if args.waiting_for is not None:
            if str(args.waiting_for).strip() == "":
                mods.append("waitingfor:")
            else:
                mods.append(f"waitingfor:{args.waiting_for}")
        return mutate_and_export(task_cmd(args.uuid, "modify", *mods))
    return err_json(f"unknown status: {st}")


def cmd_waiting_for(args: argparse.Namespace) -> int:
    if not args.uuid:
        return err_json("uuid is required")
    text = "" if args.text is None else str(args.text)
    if text.strip() == "":
        return mutate_and_export(task_cmd(args.uuid, "modify", "waitingfor:"))
    return mutate_and_export(task_cmd(args.uuid, "modify", f"waitingfor:{text}"))


def cmd_outcome(args: argparse.Namespace) -> int:
    if not args.uuid:
        return err_json("uuid is required")
    text = "" if args.text is None else str(args.text)
    if text.strip() == "":
        return mutate_and_export(task_cmd(args.uuid, "modify", "outcome:"))
    return mutate_and_export(task_cmd(args.uuid, "modify", f"outcome:{text}"))


def cmd_deps(args: argparse.Namespace) -> int:
    if not args.uuid:
        return err_json("uuid is required")
    if args.clear:
        return mutate_and_export(task_cmd(args.uuid, "modify", "depends:"))
    mods: list[str] = []
    if args.add:
        mods.append(f"depends:{args.add}")
    if args.remove:
        mods.append(f"depends:-{args.remove}")
    if not mods:
        return err_json("specify --add, --remove, or --clear")
    return mutate_and_export(task_cmd(args.uuid, "modify", *mods))


def project_task_uuids(project: str) -> tuple[list[str], str | None]:
    """UUIDs of all non-deleted tasks that use this exact project name."""
    tasks, err = export_tasks()
    if err:
        return [], err
    want = str(project or "")
    uuids: list[str] = []
    for raw in tasks:
        if str(raw.get("project") or "") != want:
            continue
        uid = str(raw.get("uuid") or "").strip()
        if uid:
            uuids.append(uid)
    return uuids, None


def cascade_set_project(old: str, new: str | None) -> subprocess.CompletedProcess[str]:
    """Set or clear project on every matching task (pending/waiting/completed).

    Bulk `task project:X modify …` prompts once the change hits Taskwarrior's
    bulk threshold — even with confirmation=off — so we modify by UUID instead.
    """
    uuids, err = project_task_uuids(old)
    if err:
        return subprocess.CompletedProcess(["task"], 1, "", err)
    if not uuids:
        return subprocess.CompletedProcess(["task"], 0, "", "")

    mod = "project:" if new is None or new == "" else f"project:{new}"
    last = subprocess.CompletedProcess(["task"], 0, "", "")
    for uuid in uuids:
        last = task_cmd(uuid, "modify", mod)
        if last.returncode != 0:
            return last
    return last


def cmd_projects(args: argparse.Namespace) -> int:
    action = args.action
    if action == "list":
        return ok_json({"ok": True, "projects": all_projects()})

    if action == "create":
        name = str(getattr(args, "name", "") or "").strip()
        if not name or ":" in name:
            return err_json("project name required (no colon)")
        tw = set(list_projects())
        extras = load_extra_projects()
        if name not in tw and name not in extras:
            extras.append(name)
            save_extra_projects(extras)
        return cmd_export(argparse.Namespace())

    if action == "rename":
        old = str(args.old or "").strip()
        new = str(args.new or "").strip()
        if not old or not new or ":" in new:
            return err_json("old and new project names required (no colon)")
        if old == new:
            return cmd_export(argparse.Namespace())

        extras = load_extra_projects()
        if old in extras:
            extras = list(dict.fromkeys(new if n == old else n for n in extras))
            save_extra_projects(extras)

        # Cascade: every task with project==old (any status) gets project:new.
        uuids, _err = project_task_uuids(old)
        if old in list_projects() or uuids:
            return mutate_and_export(cascade_set_project(old, new))
        return cmd_export(argparse.Namespace())

    if action == "clear":
        old = str(args.old or "").strip()
        if not old:
            return err_json("project name required")
        extras = [n for n in load_extra_projects() if n != old]
        save_extra_projects(extras)
        if old in list_projects() or project_task_uuids(old)[0]:
            return mutate_and_export(cascade_set_project(old, None))
        return cmd_export(argparse.Namespace())

    return err_json(f"unknown projects action: {action}")


def cmd_time(args: argparse.Namespace) -> int:
    """Manually add or remove tracked time for a task via Timewarrior."""
    uuid = str(args.uuid or "").strip()
    if not uuid:
        return err_json("uuid is required")

    raw = find_raw_task(uuid)
    if not raw:
        return err_json("task not found")

    add_text = getattr(args, "duration_add", None)
    remove_text = getattr(args, "duration_remove", None)
    duration_text = add_text if add_text is not None else remove_text
    secs = parse_duration_to_seconds(str(duration_text or ""))
    if not secs or secs <= 0:
        return err_json("invalid duration (try 30m, 1h, 1:30)")

    tags = task_timew_tags(raw)
    now = datetime.now(timezone.utc)
    has_timew = which("timew")

    if add_text is not None:
        # Prefer real Timewarrior intervals in free gaps of local today.
        # Anything that does not fit (timeline already full) goes into a
        # date-scoped UDA correction so repeated adds still accumulate.
        end_anchor = (timew_open_start() if has_timew else None) or now
        if end_anchor.tzinfo is None:
            end_anchor = end_anchor.replace(tzinfo=timezone.utc)

        remaining = secs
        if has_timew:
            slices = plan_today_track_slices(end_anchor, remaining)
            for start, end in slices:
                proc = run(["timew", "track", fmt_local(start), "-", fmt_local(end), *tags])
                if proc.returncode != 0:
                    msg = (proc.stderr or proc.stdout or "timew track failed").strip()
                    return err_json(msg)
                remaining -= int((end - start).total_seconds())

        if remaining > 0:
            day = today_key(end_anchor)
            current = timecorrection_for_today(raw.get("timecorrection"), end_anchor)
            proc = set_timecorrection(uuid, day, current + remaining)
            if proc.returncode != 0:
                msg = (proc.stderr or proc.stdout or "failed to save time correction").strip()
                return err_json(msg)

        return cmd_export(argparse.Namespace())

    # Remove: burn down today's UDA correction first, then shorten timew intervals.
    remaining = secs
    day = today_key(now)
    current = timecorrection_for_today(raw.get("timecorrection"), now)
    if current > 0 and remaining > 0:
        take = min(remaining, current)
        proc = set_timecorrection(uuid, day, current - take)
        if proc.returncode != 0:
            msg = (proc.stderr or proc.stdout or "failed to update time correction").strip()
            return err_json(msg)
        remaining -= take
        # Refresh raw correction for subsequent logic isn't needed

    if remaining > 0 and has_timew:
        guard = 0
        while remaining > 0 and guard < 50:
            guard += 1
            intervals = [
                iv
                for iv in timew_day_intervals(uuid)
                if iv.get("end") and iv.get("id") is not None
            ]
            if not intervals:
                break
            intervals.sort(key=lambda iv: str(iv.get("start") or ""), reverse=True)
            iv = intervals[0]
            length = seconds_between(str(iv.get("start")), str(iv.get("end")), now)
            if length <= 0:
                run(["timew", "delete", f"@{iv['id']}"])
                continue
            take = min(remaining, length)
            iid = f"@{iv['id']}"
            if take >= length:
                proc = run(["timew", "delete", iid])
            else:
                proc = run(["timew", "shorten", iid, f"{take}seconds"])
            if proc.returncode != 0:
                msg = (proc.stderr or proc.stdout or "timew adjust failed").strip()
                return err_json(msg)
            remaining -= take

    if remaining == secs:
        return err_json("no tracked time today to remove")
    return cmd_export(argparse.Namespace())


def main() -> int:
    parser = argparse.ArgumentParser(prog="taskwarrior-time")
    sub = parser.add_subparsers(dest="cmd", required=True)

    sub.add_parser("export")

    p_add = sub.add_parser("add")
    p_add.add_argument("--description", required=True)
    p_add.add_argument("--project", default=None)
    p_add.add_argument("--priority", default=None)
    p_add.add_argument("--scheduled", default=None)
    p_add.add_argument("--due", default=None)
    p_add.add_argument("--details", default=None)
    p_add.add_argument(
        "--status",
        default="waiting",
        help="waiting (default), pending, or completed",
    )
    p_add.add_argument("--waiting-for", default=None)
    p_add.add_argument("--outcome", default=None)
    p_add.add_argument("--depend", action="append", default=None)
    p_add.add_argument("--start-timer", action="store_true")

    p_mod = sub.add_parser("modify")
    p_mod.add_argument("--uuid", required=True)
    p_mod.add_argument("--description", default=None)
    p_mod.add_argument("--project", default=None)
    p_mod.add_argument("--priority", default=None)
    p_mod.add_argument("--scheduled", default=None)
    p_mod.add_argument("--due", default=None)
    p_mod.add_argument("--details", default=None)

    for name in ("done", "delete", "start", "stop"):
        p = sub.add_parser(name)
        p.add_argument("--uuid", required=True)

    p_st = sub.add_parser("status")
    p_st.add_argument("--uuid", required=True)
    p_st.add_argument("--status", required=True)
    p_st.add_argument("--wait", default=None)
    p_st.add_argument("--waiting-for", default=None)

    p_wf = sub.add_parser("waiting-for")
    p_wf.add_argument("--uuid", required=True)
    p_wf.add_argument("--text", default="")

    p_out = sub.add_parser("outcome")
    p_out.add_argument("--uuid", required=True)
    p_out.add_argument("--text", default="")

    p_deps = sub.add_parser("deps")
    p_deps.add_argument("--uuid", required=True)
    p_deps.add_argument("--add", default=None, help="dependency uuid or id")
    p_deps.add_argument("--remove", default=None)
    p_deps.add_argument("--clear", action="store_true")

    p_proj = sub.add_parser("projects")
    p_proj.add_argument("action", choices=["list", "create", "rename", "clear"])
    p_proj.add_argument("--old", default=None)
    p_proj.add_argument("--new", default=None)
    p_proj.add_argument("--name", default=None)

    p_time = sub.add_parser("time")
    p_time.add_argument("--uuid", required=True)
    time_grp = p_time.add_mutually_exclusive_group(required=True)
    time_grp.add_argument("--add", dest="duration_add", default=None, help="duration to add, e.g. 30m")
    time_grp.add_argument("--remove", dest="duration_remove", default=None, help="duration to remove")

    p_sg = sub.add_parser("settings-get")
    p_ss = sub.add_parser("settings-set")
    p_ss.add_argument("--debug-logging", action=argparse.BooleanOptionalAction, default=None)
    p_ss.add_argument(
        "--ui-language",
        default=None,
        choices=["system", "ru", "en"],
        help="UI language: system, ru, or en",
    )

    p_dl = sub.add_parser("debug-log")
    p_dl.add_argument("--event", required=True)
    p_dl.add_argument("--json", default=None, help="JSON object with safe detail fields")
    p_dl.add_argument("--message", default=None)
    p_dl.add_argument(
        "--level",
        default="info",
        choices=["debug", "info", "warn", "error"],
        help="Log severity for issue triage",
    )
    p_dl.add_argument(
        "--component",
        default="ui",
        choices=["ui", "helper", "system"],
        help="Which layer emitted the event",
    )
    sub.add_parser("debug-log-clear")

    args = parser.parse_args()
    handlers = {
        "export": cmd_export,
        "add": cmd_add,
        "modify": cmd_modify,
        "done": cmd_done,
        "delete": cmd_delete,
        "start": cmd_start,
        "stop": cmd_stop,
        "status": cmd_status,
        "waiting-for": cmd_waiting_for,
        "outcome": cmd_outcome,
        "deps": cmd_deps,
        "projects": cmd_projects,
        "time": cmd_time,
        "settings-get": cmd_settings_get,
        "settings-set": cmd_settings_set,
        "debug-log": cmd_debug_log,
        "debug-log-clear": cmd_debug_log_clear,
    }
    return handlers[args.cmd](args)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:  # noqa: BLE001 — surface to QML
        err_json(str(exc), code=1)
        raise SystemExit(1)
