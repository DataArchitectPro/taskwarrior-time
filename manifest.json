{
  "schemaVersion": 1,
  "id": "taskwarrior-time",
  "name": "Taskwarrior Time",
  "version": "1.0.2",
  "author": "DataArchitectPro",
  "license": "MIT",
  "description": "Taskwarrior + Timewarrior panel: list, CRUD, projects, deps, timers",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Taskwarrior Time",
    "description": "Taskwarrior + Timewarrior companion for the Omarchy bar",
    "category": "Productivity",
    "allowMultiple": false,
    "defaultSection": "right",
    "schema": [
      {
        "key": "showWhenEmpty",
        "type": "boolean",
        "label": "Show when empty",
        "description": "Keep the Taskwarrior Time icon visible when there are no pending tasks",
        "defaultValue": true
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 5,
        "max": 3600,
        "step": 5,
        "defaultValue": 30
      },
      {
        "key": "defaultGroupBy",
        "type": "string",
        "label": "Default group by",
        "description": "project | priority | due | status | none",
        "defaultValue": "project"
      }
    ]
  }
}
