#!/usr/bin/env bash
# Point this clone at the repo-managed git hooks (pre-push runs scripts/check).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

git config core.hooksPath .githooks
chmod +x .githooks/pre-push scripts/check scripts/validate-plugin scripts/enable-git-hooks

echo "git hooksPath -> .githooks (pre-push will run ./scripts/check)"
echo "Try: git push (or ./scripts/check)"
